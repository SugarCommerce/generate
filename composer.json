{
  "name": "sugarcommerce/generate",
  "version": "1.2.0",
  "description": "Identifier generation: UUID v4 and v7, human-readable licence and discount codes, transliterating slugs, and CSPRNG-backed API keys. Zero dependencies.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarcommerce/generate",
  "authors": [ { "name": "David Sherlock", "homepage": "https://arraypress.com/" } ],
  "keywords": ["uuid", "uuid7", "slug", "license-key", "discount-code", "api-key", "token", "random"],
  "require": { "php": ">=8.5" },
  "require-dev": { "phpunit/phpunit": "^13.0" },
  "suggest": { "ext-intl": "Sharper transliteration for non-Latin scripts in slugs." },
  "autoload": { "psr-4": { "SugarCommerce\\Generate\\": "src/" } },
  "autoload-dev": { "psr-4": { "SugarCommerce\\Generate\\Tests\\": "tests/" } },
  "scripts": { "test": "phpunit" },
  "config": { "optimize-autoloader": true, "sort-packages": true, "preferred-install": "dist" },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "support": { "issues": "https://github.com/sugarcommerce/generate/issues", "source": "https://github.com/sugarcommerce/generate" }
}
